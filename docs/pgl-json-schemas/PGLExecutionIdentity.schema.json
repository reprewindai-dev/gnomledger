{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pgl.veklom.com/schemas/PGLExecutionIdentity.schema.json",
  "title": "PGLExecutionIdentity",
  "type": "object",
  "properties": {
    "execution_id": { "type": "string" },
    "agent_id": { "type": "string" },
    "delegation_ref": { "type": "string" },
    "ephemeral_public_key": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" },
    "signature": { "type": "string" }
  },
  "required": ["execution_id", "agent_id", "delegation_ref", "ephemeral_public_key", "created_at", "signature"],
  "examples": [
    {
      "execution_id": "exec-12345",
      "agent_id": "did:web:agent.example.com",
      "delegation_ref": "urn:uuid:f81d4fae-7dec-11d0-a765-00a0c91e6bf6",
      "ephemeral_public_key": {
        "kty": "OKP",
        "crv": "Ed25519",
        "x": "temp_pub_key_value"
      },
      "created_at": "2026-08-10T12:00:00Z",
      "signature": "signature_by_agent_identity"
    }
  ]
}
