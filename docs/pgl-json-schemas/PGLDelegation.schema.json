      "capability": "urn:veklom:cap:deploy",
      "resource": "arn:aws:ec2:region:account:instance/instance-id",
      "budget": "100.00 USD",
      "valid_from": "2026-08-10T00:00:00Z",
      "valid_until": "2026-08-11T00:00:00Z",
      "delegation_depth": 1,
      "signature": "eyJhbGciOiJFZERTQSIsImI2NCI6ZmFsc2UsImNyaXQiOlsiYjY0Il19..sig_value"
    }
