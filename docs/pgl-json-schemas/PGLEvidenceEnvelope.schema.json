      "input_hash": "sha256:d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2",
      "output_hash": "sha256:e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3",
      "policy_ref": "policy-402",
      "timestamp": "2026-08-10T12:05:00Z",
      "settlement_ref": "tx-99999",
      "measurement_refs": ["vnp-measure-1"],
      "signature": "signature_by_ephemeral_key"
    }
  ]
}
